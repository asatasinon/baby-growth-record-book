APP_ENV=local
APP_SECRET=replace_me
JWT_SECRET=replace_me

# Uvicorn runtime
API_HOST=0.0.0.0
API_PORT=8080
API_RELOAD=true
API_LOG_LEVEL=info
API_WORKERS=1

# DB config used by API/worker
DB_HOST=postgres
DB_PORT=5432
DB_NAME=baby_growth
DB_USER=baby_growth
DB_PASSWORD=baby_growth

# Postgres container init env
POSTGRES_DB=baby_growth
POSTGRES_USER=baby_growth
POSTGRES_PASSWORD=baby_growth

WECHAT_APP_ID=wx_replace_me
WECHAT_APP_SECRET=replace_me

OBJECT_STORAGE_ENDPOINT=https://example-oss.local
OBJECT_STORAGE_BUCKET=baby-growth
OBJECT_STORAGE_ACCESS_KEY=replace_me
OBJECT_STORAGE_SECRET_KEY=replace_me

LLM_BASE_URL=https://example-llm.local
LLM_API_KEY=replace_me
