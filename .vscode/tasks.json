{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动前端服务",
      "type": "shell",
      "command": "cd ./frontend && npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "Server started"
        }
      }
    },
    {
      "label": "启动后端服务",
      "type": "shell",
      "command": "cd ./backend && uv run python main.py",
      "isBackground": true,
      "group": "build"
    }
  ]
}
